local function createGhost()
    if God.GhostPart then
        pcall(function() God.GhostPart:Destroy() end)
        God.GhostPart = nil
    end
    local p = Instance.new("Part")
    p.Name = "GhostPart"
    p.Anchored = false
    p.CanCollide = false
    p.Transparency = 1
    p.Size = Vector3.new(0.1, 0.1, 0.1)
