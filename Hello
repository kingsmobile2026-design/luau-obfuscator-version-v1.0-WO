LocalPlayer.CharacterAdded:Connect(setupLocalChar)

local function executeAttachLoop()
    if not Attach.LocalHRP or not Attach.LocalHRP.Parent then return end

    -- Attach OFF / TPA 공허 이동 중이면 위치 보정하지 않음
    if not Attach.Enabled or getgenv().TPA_Voiding then
        return
    end

    if not Attach.TargetHRP or not Attach.TargetHRP.Parent then
        if Attach.Target and Attach.Target.Character then
            Attach.TargetHRP = Attach.Target.Character:FindFirstChild("HumanoidRootPart")
        end
    end

    if Attach.TargetHRP and Attach.TargetHRP.Parent then
        local tPos = Attach.TargetHRP.Position
        if math.isfinite(tPos.X) and math.isfinite(tPos.Y) and math.isfinite(tPos.Z) then
            if tPos.Y > Attach.VoidHeight then
                Attach.SafePosition = tPos + Vector3.new(0, 10, 0)
            end
        end
    end

    if Attach.LocalHRP.Position.Y < Attach.VoidHeight then
        Attach.LocalHRP.CFrame = CFrame.new(Attach.SafePosition)
        Attach.LocalHRP.AssemblyLinearVelocity = Vector3.zero
        return
    end

    if not Attach.Target or not Attach.TargetHRP or not Attach.TargetHRP.Parent then
        return
    end

    Attach.LocalHRP.CanCollide = true
    Attach.TargetHRP.CanCollide = true

    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(LocalPlayer, "MaximumSimulationRadius", 100000)
            sethiddenproperty(LocalPlayer, "SimulationRadius", 100000)
            sethiddenproperty(Attach.LocalHRP, "NetworkIsSleeping", false)
        end
    end)

    setPhysicsRep(Attach.LocalHRP, Attach.TargetHRP)

    local targetCF = Attach.TargetHRP.CFrame
    local vel = Attach.TargetHRP.AssemblyLinearVelocity
    if not (math.isfinite(vel.X) and math.isfinite(vel.Y) and math.isfinite(vel.Z)) then
        vel = Vector3.zero
    end

    local predictedCF = targetCF
    local offset = getAttachOffset()
    getgenv().AttachOffset = offset
    Attach.LocalHRP.CFrame = predictedCF * offset
    Attach.LocalHRP.AssemblyLinearVelocity = vel
end

RunService.Stepped:Connect(executeAttachLoop)
RunService.RenderStepped:Connect(executeAttachLoop)
RunService.Heartbeat:Connect(executeAttachLoop)

function Attach.Start(player)
    local plr = typeof(player) == "Instance" and player:IsA("Player") and player or findPlayer(tostring(player))
    if not plr then return false end

    Attach.Stop()
    Attach.Target = plr
    Attach.Enabled = true

    if plr.Character then
        Attach.TargetHRP = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:WaitForChild("HumanoidRootPart", 2)
        if Attach.LocalHRP and Attach.TargetHRP then
            setPhysicsRep(Attach.LocalHRP, Attach.TargetHRP)
        end
    end

    Attach.CharConn = plr.CharacterAdded:Connect(function(char)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if hrp then
            Attach.TargetHRP = hrp
            if Attach.LocalHRP then
                setPhysicsRep(Attach.LocalHRP, Attach.TargetHRP)
            end
        end
    end)

    if getgenv().addvape then pcall(getgenv().addvape, "attach") end
    return true
end

function Attach.Stop()
    Attach.Enabled = false
    Attach.Target = nil
    Attach.TargetHRP = nil

    if Attach.CharConn then
        Attach.CharConn:Disconnect()
        Attach.CharConn = nil
    end

    if Attach.LocalHRP then
        setPhysicsRep(Attach.LocalHRP, nil)
        if Attach.Humanoid then
            Attach.Humanoid.PlatformStand = false
            pcall(function() Attach.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        pcall(function()
            Attach.LocalHRP.AssemblyLinearVelocity = Vector3.zero
            Attach.LocalHRP.Velocity = Vector3.zero
        end)
    end

    if getgenv().delvape then
        pcall(getgenv().delvape, "attach")
        pcall(getgenv().delvape, "at")
        pcall(getgenv().delvape, "looptp")
    end
end

-- //======= INVIS 모듈 =======//
local Invis = {
    Alive = true,
    Enabled = false,
    AnimationId = "rbxassetid://107114358965793",
    AnimationTime = 18,
    FadeTransparency = 0.5,
}

local invisConns = {}
local invisDescConns = {}
local transparencyCache = {}
local invisChar, invisHum, invisHRP
local invisAnim, invisTrack
local invisBusy = false

local function disconnectTable(t)
    for k, c in pairs(t) do
        pcall(function() c:Disconnect() end)
        t[k] = nil
    end
end

local function destroyInvisAnim()
    if invisTrack then
        pcall(function() invisTrack:Stop(0) end)
        pcall(function() invisTrack:Destroy() end)
        invisTrack = nil
    end
    if invisAnim then
        pcall(function() invisAnim:Destroy() end)
        invisAnim = nil
    end
end

local function loadInvisAnim(humanoid)
    if invisTrack and invisHum == humanoid then return invisTrack end
    destroyInvisAnim()
    local animator = humanoid:FindFirstChildWhichIsA("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    invisAnim = Instance.new("Animation")
    invisAnim.AnimationId = Invis.AnimationId
    local ok, track = pcall(animator.LoadAnimation, animator, invisAnim)
    if not ok or not track then
        destroyInvisAnim()
        return nil
    end
    track.Priority = Enum.AnimationPriority.Action4
    invisTrack = track
    return invisTrack
end

local function isHitbox(obj)
    return obj.Name:lower():find("hitbox", 1, true) ~= nil
end

local function getOrigTransparency(obj)
    if transparencyCache[obj] == nil then
        transparencyCache[obj] = obj.Transparency
    end
    return transparencyCache[obj]
end

local function applyFade(obj)
    if not invisHRP then return end
    if obj:IsA("BasePart") then
        if obj == invisHRP then return end
        local orig = getOrigTransparency(obj)
        if isHitbox(obj) or orig == 1 then
            obj.Transparency = 1
        else
            obj.Transparency = Invis.FadeTransparency
        end
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        local parent = obj.Parent
        if parent and isHitbox(parent) then return end
        if getOrigTransparency(obj) ~= 1 then
            obj.Transparency = Invis.FadeTransparency
        end
    end
end

local function applyFadeAll(char)
    for _, d in ipairs(char:GetDescendants()) do
        applyFade(d)
    end
end

local function refreshFade()
    for obj, orig in pairs(transparencyCache) do
        if not obj.Parent then
            transparencyCache[obj] = nil
        elseif obj:IsA("BasePart") then
            if obj ~= invisHRP then
                if isHitbox(obj) or orig == 1 then
                    obj.Transparency = 1
                else
                    obj.Transparency = Invis.FadeTransparency
                end
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            local parent = obj.Parent
            if (not parent or not isHitbox(parent)) and orig ~= 1 then
                obj.Transparency = Invis.FadeTransparency
            end
        end
    end
end

local function restoreTransparency()
    for obj, orig in pairs(transparencyCache) do
        if obj.Parent then
            pcall(function() obj.Transparency = orig end)
        end
        transparencyCache[obj] = nil
    end
end

local function stopInvisTrack()
    if invisTrack and invisTrack.IsPlaying then
        pcall(function() invisTrack:Stop(0) end)
    end
end

local function setupInvisChar(char)
    disconnectTable(invisDescConns)
    restoreTransparency()
    destroyInvisAnim()
    invisChar, invisHum, invisHRP = nil, nil, nil
    if not char then return end

    local hum = char:WaitForChild("Humanoid", 10)
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if not Invis.Alive or LocalPlayer.Character ~= char or not hum or not hrp then return end
    invisChar = char
    invisHum = hum
    invisHRP = hrp

    invisDescConns.descendantAdded = char.DescendantAdded:Connect(function(d)
        if Invis.Enabled then task.defer(applyFade, d) end
    end)

    if Invis.Enabled then applyFadeAll(char) end
end

local function invisHeartbeat()
    if not Invis.Alive or not Invis.Enabled or invisBusy then return end
    if not invisChar or not invisHum or not invisHRP then return end
    if invisHum.Health <= 0 or not invisHRP.Parent then return end

    invisBusy = true
    refreshFade()
    local track = loadInvisAnim(invisHum)

    pcall(function()
        if track then
            if not track.IsPlaying then track:Play(0) end
            track.TimePosition = Invis.AnimationTime
            track:AdjustSpeed(0)
            track:AdjustWeight(1, 0)
        end
        RunService.RenderStepped:Wait()
    end)

    stopInvisTrack()
    invisBusy = false
end

function Invis.SetEnabled(state)
    Invis.Enabled = state == true
    if Invis.Enabled then
        if invisChar then applyFadeAll(invisChar) end
    else
        stopInvisTrack()
        restoreTransparency()
    end
    return Invis.Enabled
end

function Invis.Toggle()
    return Invis.SetEnabled(not Invis.Enabled)
end

invisConns.heartbeat = RunService.Heartbeat:Connect(invisHeartbeat)
invisConns.characterAdded = LocalPlayer.CharacterAdded:Connect(function(c)
    task.spawn(setupInvisChar, c)
end)
task.spawn(setupInvisChar, LocalPlayer.Character)
getgenv().TSBInvisibility = Invis

-- //======= ANTI-VOID 모듈 =======//
local AntiVoid = {
    Enabled = false,
    Part = nil,
    ConnFPDH = nil,
    ConnRender = nil,
    ConnHealth = nil,
    ConnChar = nil,
    LastHealth = 100,
}

local function setupAntiVoidChar(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 3)
    local hrp = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 3)
    if not humanoid or not hrp then return end

    AntiVoid.LastHealth = humanoid.Health
    if AntiVoid.ConnHealth then AntiVoid.ConnHealth:Disconnect() AntiVoid.ConnHealth = nil end
    if AntiVoid.ConnRender then AntiVoid.ConnRender:Disconnect() AntiVoid.ConnRender = nil end

    AntiVoid.ConnRender = RunService.RenderStepped:Connect(function()
        if not AntiVoid.Enabled then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        local hum = character:FindFirstChildOfClass("Humanoid")
        if root and hum then
            AntiVoid.LastHealth = hum.Health
            if AntiVoid.Part then
                AntiVoid.Part.CFrame = CFrame.new(root.Position.X, -10008, root.Position.Z)
            end
        end
    end)

    AntiVoid.ConnHealth = humanoid.HealthChanged:Connect(function(newHealth)
        if not AntiVoid.Enabled then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        if newHealth <= 0 and root and root.CFrame.Y <= 0 then
            humanoid.Health = AntiVoid.LastHealth
        end
    end)
end

function AntiVoid.Stop()
    AntiVoid.Enabled = false
    if AntiVoid.ConnFPDH then AntiVoid.ConnFPDH:Disconnect() AntiVoid.ConnFPDH = nil end
    if AntiVoid.ConnRender then AntiVoid.ConnRender:Disconnect() AntiVoid.ConnRender = nil end
    if AntiVoid.ConnHealth then AntiVoid.ConnHealth:Disconnect() AntiVoid.ConnHealth = nil end
    if AntiVoid.ConnChar then AntiVoid.ConnChar:Disconnect() AntiVoid.ConnChar = nil end
    if AntiVoid.Part then
        pcall(function() AntiVoid.Part:Destroy() end)
        AntiVoid.Part = nil
    end
    pcall(function()
        if getgenv().FPDH then
            workspace.FallenPartsDestroyHeight = getgenv().FPDH
        end
    end)
end

function AntiVoid.Start(targetChar)
    if getgenv().addvape then pcall(getgenv().addvape, "antivoid") end
    AntiVoid.Stop()
    AntiVoid.Enabled = true

    getgenv().FPDH = workspace.FallenPartsDestroyHeight
    workspace.FallenPartsDestroyHeight = (0/0)

    AntiVoid.ConnFPDH = workspace:GetPropertyChangedSignal("FallenPartsDestroyHeight"):Connect(function()
        local current = workspace.FallenPartsDestroyHeight
        if current == current then
            workspace.FallenPartsDestroyHeight = (0/0)
        end
    end)

    local p = Instance.new("Part")
    p.Name = "AntiVoidFloor_" .. HttpService:GenerateGUID()
    p.Size = Vector3.new(4096, 10, 4096)
    p.CFrame = CFrame.new(0, -10008, 0)
    p.Anchored = true
    p.CanCollide = true
    p.Transparency = 0.5
    p.Material = Enum.Material.Neon
    p.Color = Color3.fromRGB(0, 200, 255)
    p.Parent = workspace
    AntiVoid.Part = p

    local char = targetChar or LocalPlayer.Character
    if char then setupAntiVoidChar(char) end

    AntiVoid.ConnChar = LocalPlayer.CharacterAdded:Connect(function(newChar)
        task.wait(0.1)
        if AntiVoid.Enabled then setupAntiVoidChar(newChar) end
    end)
end

function AntiVoid.Toggle()
    if AntiVoid.Enabled then
        if getgenv().delvape then pcall(getgenv().delvape, "antivoid") end
        AntiVoid.Stop()
        notify("Anti-Void", "안티보이드 OFF", 2)
    else
        AntiVoid.Start()
        notify("Anti-Void", "안티보이드 ON", 2)
    end
    return AntiVoid.Enabled
end

-- //======= LOOPFLING 모듈 =======//
local LoopFling = {
    Enabled = false,
    Targets = {},
    Thread = nil,
}

local function isTooHigh(char)
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { char, LocalPlayer.Character }
    params.FilterType = Enum.RaycastFilterType.Blacklist
    local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -500, 0), params)
    if hit then
        return (hrp.Position - hit.Position).Magnitude > 30
    end
    return true
end

function LoopFling.Start(playerList)
    LoopFling.Stop()

    local targets = {}
    if typeof(playerList) == "table" then
        for _, p in ipairs(playerList) do
            local plr = typeof(p) == "Instance" and p:IsA("Player") and p or findPlayer(tostring(p))
            if plr and plr ~= LocalPlayer then
                table.insert(targets, plr)
            end
        end
    else
        local plr = typeof(playerList) == "Instance" and playerList:IsA("Player") and playerList or findPlayer(tostring(playerList))
        if plr then table.insert(targets, plr) end
    end

    if #targets == 0 then
        notify("LoopFling", "대상을 찾을 수 없습니다", 2)
        return false
    end

    LoopFling.Targets = targets
    LoopFling.Enabled = true
    getgenv().LoopFlingActive = true

    local names = {}
    for _, t in ipairs(targets) do
        table.insert(names, t.Name)
        if getgenv().addTargetCmd then
            pcall(getgenv().addTargetCmd, t, "loopfling")
        end
    end
    notify("LoopFling", table.concat(names, ", ") .. " LoopFling 시작!", 2)

    if getgenv().addvape then pcall(getgenv().addvape, "loopfling") end

    local idx = 1
    LoopFling.Thread = task.spawn(function()
        settings().Physics.AllowSleep = false
        pcall(function()
            if sethiddenproperty then
                sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
                sethiddenproperty(LocalPlayer, "MaxSimulationRadius", math.huge)
            end
        end)

        while LoopFling.Enabled and getgenv().LoopFlingActive do
            local target = LoopFling.Targets[idx]
            if target and target.Parent == Players and target.Character then
                local char = LocalPlayer.Character
                if char then
                    local myHRP = char:FindFirstChild("HumanoidRootPart")
                    local theirHRP = target.Character:FindFirstChild("HumanoidRootPart")
                    if myHRP and theirHRP and not isTooHigh(target.Character) then
                        local savedCF = myHRP.CFrame
                        local conn = nil
                        local stopFlag = false

                        conn = RunService.Heartbeat:Connect(function()
                            if not LoopFling.Enabled or not target or not target.Character or stopFlag then
                                if conn then conn:Disconnect() end
                                return
                            end
                            local c2 = LocalPlayer.Character
                            if not c2 then
                                if conn then conn:Disconnect() end
                                return
                            end
                            local hrp3 = c2:FindFirstChild("HumanoidRootPart")
                            local hrp4 = target.Character:FindFirstChild("HumanoidRootPart")
                            local hum = c2:FindFirstChildOfClass("Humanoid")
                            if not hrp3 or not hrp4 then
                                if conn then conn:Disconnect() end
                                return
                            end
                            if isTooHigh(target.Character) then
                                stopFlag = true
                                if conn then conn:Disconnect() end
                                return
                            end
                            if hum then hum.PlatformStand = true end
                            for _, d in pairs(c2:GetDescendants()) do
                                if d:IsA("BasePart") then
                                    d.CanCollide = false
                                    d.CanTouch = false
                                    d.CanQuery = false
                                    local power = getFlingPower()
                                    d.Velocity = Vector3.new(power, power, power)
                                    d.RotVelocity = Vector3.new(power, power, power)
                                end
                            end
                            pcall(setPhysicsRep, hrp3, hrp4)
                            local power = getFlingPower()
                            hrp3.Velocity = Vector3.new(power, power, power)
                            hrp3.RotVelocity = Vector3.new(power, power, power)
                            hrp3.CFrame = hrp4.CFrame
                                * CFrame.Angles(math.rad(math.random(0,360)), math.rad(math.random(0,360)), math.rad(math.random(0,360)))
                                * CFrame.new(0, 0, 0.05)
                        end)

                        local start = tick()
                        while not stopFlag and tick() - start <= 3 and LoopFling.Enabled do
                            task.wait()
                        end
                        if conn then conn:Disconnect() end

                        if LocalPlayer.Character then
                            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                            if hum then hum.PlatformStand = false end
                            if hrp then
                                hrp.CFrame = savedCF
                                hrp.Velocity = Vector3.zero
                                hrp.RotVelocity = Vector3.zero
                            end
                        end
                        task.wait(0.2)
                    end
                end
            end

            idx = idx + 1
            if idx > #LoopFling.Targets then idx = 1 end
            task.wait(0.1)
        end
    end)

    return true
end

function LoopFling.Stop()
    LoopFling.Enabled = false
    getgenv().LoopFlingActive = false
    LoopFling.Targets = {}
    if LoopFling.Thread then
        -- thread will exit on next loop check
        LoopFling.Thread = nil
    end
    if getgenv().removeTargetCmd then
        pcall(getgenv().removeTargetCmd, nil, "loopfling")
    end
    if getgenv().delvape then pcall(getgenv().delvape, "loopfling") end
    notify("LoopFling", "LoopFling 중지됨", 2)
end

function LoopFling.Toggle(playerOrList)
    if LoopFling.Enabled then
        LoopFling.Stop()
        return false
    else
        return LoopFling.Start(playerOrList)
    end
end

local KillFarm = {
    Enabled = false,
    Thread = nil,
    CurrentTarget = nil,
}

local function getLowestHPPlayer()
    local best, bestHP = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not Whitelist.IsWhitelisted(plr) then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and hum.Health < bestHP then
                bestHP = hum.Health
                best = plr
            end
        end
    end
    return best, bestHP
end

function KillFarm.Start()
    if KillFarm.Enabled then return end
    KillFarm.Enabled = true
    if getgenv().addvape then pcall(getgenv().addvape, "killfarm") end
    notify("KillFarm", "Kill Farm ON — 최저 체력 대상 Attach", 2)

    KillFarm.Thread = task.spawn(function()
        while KillFarm.Enabled do
            local target = getLowestHPPlayer()
            if target then
                if KillFarm.CurrentTarget ~= target then
                    KillFarm.CurrentTarget = target
                    Attach.Start(target)
                    notify("KillFarm", "대상: " .. target.Name .. " (HP 낮음)", 1.5)
                elseif not Attach.Enabled or Attach.Target ~= target then
                    Attach.Start(target)
                end
            end
            task.wait(0.5)
        end
    end)
end

function KillFarm.Stop()
