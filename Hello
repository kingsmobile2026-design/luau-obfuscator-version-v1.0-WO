    lbl.Size = UDim2.fromOffset(70, 22)
    lbl.Position = UDim2.fromOffset(10, y)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = Theme.SubText
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = DistPanel

    local box = Instance.new("TextBox")
    box.Size = UDim2.fromOffset(180, 24)
    box.Position = UDim2.fromOffset(85, y)
    box.BackgroundColor3 = Theme.Secondary
    box.Text = tostring(default)
    box.PlaceholderText = "숫자"
    box.PlaceholderColor3 = Color3.fromRGB(100, 100, 100)
    box.TextColor3 = Theme.Text
    box.Font = Enum.Font.Gotham
    box.TextSize = 12
    box.ClearTextOnFocus = false
    box.Parent = DistPanel
    makeCorner(box, 4)
    makeStroke(box, Theme.Border, 1)
    return box
end

local BoxX = makeDistRow(36, "좌우 X", Config.AttachX or 0)
local BoxY = makeDistRow(66, "위아래 Y", Config.AttachY or 0)
local BoxZ = makeDistRow(96, "앞뒤 Z", Config.AttachZ or 6)
local BoxPitch = makeDistRow(126, "상하각°", Config.AttachPitch or 0)
local BoxYaw = makeDistRow(156, "좌우각°", Config.AttachYaw or 0)
local BoxRoll = makeDistRow(186, "롤°", Config.AttachRoll or 0)

local DistApply = Instance.new("TextButton")
DistApply.Size = UDim2.fromOffset(250, 28)
DistApply.Position = UDim2.fromOffset(15, 220)
DistApply.BackgroundColor3 = Color3.fromRGB(50, 120, 80)
DistApply.Text = "✔ 적용"
DistApply.TextColor3 = Theme.Text
DistApply.Font = Enum.Font.GothamBold
DistApply.TextSize = 12
DistApply.Parent = DistPanel
makeCorner(DistApply, 6)

local AttachDistOpen = false

DistApply.MouseButton1Click:Connect(function()
    Config.AttachX = parseNumber(BoxX.Text, Config.AttachX or 0)
    Config.AttachY = parseNumber(BoxY.Text, Config.AttachY or 0)
    Config.AttachZ = parseNumber(BoxZ.Text, Config.AttachZ or 6)
    Config.AttachPitch = parseNumber(BoxPitch.Text, Config.AttachPitch or 0)
    Config.AttachYaw = parseNumber(BoxYaw.Text, Config.AttachYaw or 0)
    Config.AttachRoll = parseNumber(BoxRoll.Text, Config.AttachRoll or 0)
    getgenv().AttachOffset = getAttachOffset()
    notify("Attach", string.format("X=%.3g Y=%.3g Z=%.3g Pitch=%.3g Yaw=%.3g Roll=%.3g",
        Config.AttachX, Config.AttachY, Config.AttachZ,
        Config.AttachPitch, Config.AttachYaw, Config.AttachRoll), 2)
end)

local function applyFlingFromBox()
    Config.FlingPower = parseNumber(FlingBox.Text, Config.FlingPower)
    local fp = Config.FlingPower
    local fpStr
    if fp ~= fp then fpStr = "NaN"
    elseif fp == math.huge then fpStr = "Inf"
    elseif fp == -math.huge then fpStr = "-Inf"
    else fpStr = tostring(fp) end
    notify("Fling", "강도 = " .. fpStr, 2)
end

FlingApplyArea.MouseButton1Click:Connect(applyFlingFromBox)
FlingBox.FocusLost:Connect(function(enter)
    if enter then applyFlingFromBox() end
end)

-- //======= UI 갱신 =======//
local function setToggle(btn, name, on)
    if on then
        btn.Text = "● " .. name
        btn.BackgroundColor3 = Theme.On
    else
        btn.Text = "○ " .. name
        btn.BackgroundColor3 = Theme.Off
    end
end

local function refreshUI()
    setToggle(AttachBtn, "Attach", Attach.Enabled)
    setToggle(InvisBtn, "Invis", Invis.Enabled)
    setToggle(AntiVoidBtn, "Anti-Void", AntiVoid.Enabled)
    setToggle(LoopFlingBtn, "LoopFling", LoopFling.Enabled)
    setToggle(KillFarmBtn, "Kill Farm", KillFarm.Enabled)
    setToggle(AttachDistBtn, "Attach 거리", AttachDistOpen)

    if KillFarm.Enabled and KillFarm.CurrentTarget then
        StatusLabel.Text = "KillFarm → " .. KillFarm.CurrentTarget.Name
        StatusLabel.TextColor3 = Theme.Orange
    elseif Attach.Enabled and Attach.Target then
        StatusLabel.Text = "Attach → " .. Attach.Target.Name
        StatusLabel.TextColor3 = Theme.On
    elseif LoopFling.Enabled and #LoopFling.Targets > 0 then
        StatusLabel.Text = "LoopFling → " .. LoopFling.Targets[1].Name
        StatusLabel.TextColor3 = Theme.Orange
    elseif TPA.Running then
        StatusLabel.Text = "TPA 실행 중..."
        StatusLabel.TextColor3 = Theme.Accent
    else
        StatusLabel.Text = "상태: 대기"
        StatusLabel.TextColor3 = Theme.SubText
    end

    TPABtn.Text = TPA.Running and "■ TPA 중지" or "▶ Attach All (TPA)"
    TPABtn.BackgroundColor3 = TPA.Running and Theme.Off or Theme.Accent

    if Whitelist.ShowList then
        WhitelistBtn.Text = "● Whitelist"
        WhitelistBtn.BackgroundColor3 = Theme.On
        WLPanel.Visible = true
        refreshWhitelistPanel()
    else
        WhitelistBtn.Text = "○ Whitelist"
        WhitelistBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
        WLPanel.Visible = false
    end

    DistPanel.Visible = AttachDistOpen
end

-- 이벤트
AttachBtn.MouseButton1Click:Connect(function()
    if Attach.Enabled then
        Attach.Stop()
    else
        local t = findPlayer(NameBox.Text)
        if not t then
            StatusLabel.Text = "플레이어를 찾을 수 없음"
            StatusLabel.TextColor3 = Theme.Off
            return
        end
        Attach.Start(t)
    end
    refreshUI()
end)

InvisBtn.MouseButton1Click:Connect(function()
    Invis.Toggle()
    refreshUI()
end)

AntiVoidBtn.MouseButton1Click:Connect(function()
    AntiVoid.Toggle()
    refreshUI()
end)

LoopFlingBtn.MouseButton1Click:Connect(function()
    if LoopFling.Enabled then
        LoopFling.Stop()
    else
        local t = findPlayer(NameBox.Text)
        if not t then
            StatusLabel.Text = "LoopFling 대상 필요"
            StatusLabel.TextColor3 = Theme.Off
            return
        end
        applyFlingFromBox()
        LoopFling.Start(t)
    end
    refreshUI()
end)

KillFarmBtn.MouseButton1Click:Connect(function()
    if TPA.Running then TPA.Stop() end
    KillFarm.Toggle()
    refreshUI()
end)

AttachDistBtn.MouseButton1Click:Connect(function()
    AttachDistOpen = not AttachDistOpen
    DistPanel.Visible = AttachDistOpen
    refreshUI()
end)

WhitelistBtn.MouseButton1Click:Connect(function()
    Whitelist.ShowList = not Whitelist.ShowList
    refreshUI()
end)

TPABtn.MouseButton1Click:Connect(function()
    if TPA.Running then
        TPA.Stop()
    else
        TPA.Start()
    end
    refreshUI()
end)

StopAllBtn.MouseButton1Click:Connect(function()
    KillFarm.Stop()
    Attach.Stop()
    Invis.SetEnabled(false)
    if AntiVoid.Enabled then AntiVoid.Toggle() end
    LoopFling.Stop()
    TPA.Stop()
    refreshUI()
    notify("TSB", "모든 기능 중지됨", 2)
end)

Players.PlayerRemoving:Connect(function(plr)
    if Attach.Target == plr then Attach.Stop() end
    if LoopFling.Enabled then
        for i, t in ipairs(LoopFling.Targets) do
            if t == plr then
                table.remove(LoopFling.Targets, i)
                break
            end
        end
        if #LoopFling.Targets == 0 then LoopFling.Stop() end
    end
    refreshUI()
end)

task.spawn(function()
    while ScreenGui and ScreenGui.Parent do
        refreshUI()
        task.wait(0.5)
    end
end)

refreshUI()

getgenv().TSB_Combined = {
    Attach = Attach,
    Invis = Invis,
    AntiVoid = AntiVoid,
    LoopFling = LoopFling,
    TPA = TPA,
    KillFarm = KillFarm,
    Whitelist = Whitelist,
    Config = Config,
    parseNumber = parseNumber,
    RefreshUI = refreshUI,
    FindPlayer = findPlayer,
    Gui = ScreenGui,
    DistPanel = DistPanel,
}

print("[TSB Combined v2.3] Loaded — Invis + Attach + AntiVoid + LoopFling + TPA + KillFarm")
