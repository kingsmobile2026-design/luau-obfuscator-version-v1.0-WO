    return p
end

local function destroyGhost()
    if God.GhostPart then
        pcall(function() God.GhostPart:Destroy() end)
        God.GhostPart = nil
    end
end

local function setRepToGhost()
    local c = getChar()
    if not c or not God.GhostPart then return end
    pcall(function()
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") then
                pcall(sethiddenproperty or set_hidden_property or function() end, d, "NetworkIsSleeping", false)
                setPhysicsRep(d, God.GhostPart)
            end
        end
    end)
end

local function clearRep()
    local c = getChar()
    if not c then return end
    pcall(function()
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") then
                setPhysicsRep(d, nil)
            end
        end
    end)
end

local function createPlatform(cf)
    if God.UndergroundPlatform and God.UndergroundPlatform.Parent then
        God.UndergroundPlatform.CFrame = cf * CFrame.new(0, -5, 0)
        return God.UndergroundPlatform
    end
    if God.UndergroundPlatform then
        pcall(function() God.UndergroundPlatform:Destroy() end)
        God.UndergroundPlatform = nil
    end
    local p = Instance.new("Part")
    p.Name = "GodmodeSafetyPlatform"
    p.Size = Vector3.new(100, 4, 100)
    p.CFrame = cf * CFrame.new(0, -5, 0)
    p.Anchored = true
    p.CanCollide = true
    p.Transparency = 1
    p.Parent = workspace
    God.UndergroundPlatform = p
    return p
end

local function destroyPlatform()
    if God.UndergroundPlatform then
        pcall(function() God.UndergroundPlatform:Destroy() end)
        God.UndergroundPlatform = nil
    end
end

local function doTeleportCycle()
    local char = getChar()
    local root = getRoot()
    if not root or not char then return end

    if God.Teleporting then
        if God.SavedCFrame and root.Position.Y <= God.SavedCFrame.Position.Y - 50 then
            root.CFrame = God.SavedCFrame
            root.AssemblyLinearVelocity = Vector3.zero
        end
        return
    end

    if not God.SavedCFrame or root.Position.Y > God.SavedCFrame.Position.Y - 50 then
        God.SavedCFrame = root.CFrame
    end

    local under = God.SavedCFrame * CFrame.new(0, Config.TeleportDepth, 0)
    createPlatform(under)
    God.Teleporting = true

    local fakePaused = getgenv().fakepos_enabled == true
    if fakePaused then
        getgenv().fakepos_pause = true
        task.wait(0.12)
    end

    for _ = 1, 6 do
        RunService.Stepped:Wait()
        if God.Enabled then
            root.CFrame = under
            root.AssemblyLinearVelocity = Vector3.zero
        else
            break
        end
    end

    task.wait(0.225)

    if root and God.SavedCFrame then
        for _ = 1, 6 do
            RunService.Stepped:Wait()
            root.CFrame = God.SavedCFrame
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end

    God.Teleporting = false
    if fakePaused then
        getgenv().fakepos_pause = false
    end
end

function God.Enable(skipTeleport)
    if God.Enabled then return end
    God.Enabled = true

    if getgenv().addvape then
        pcall(getgenv().addvape, "godmode")
    end

    createGhost()

    if God.LoopThread then
        task.cancel(God.LoopThread)
        God.LoopThread = nil
    end

    God.LoopThread = task.spawn(function()
        if not skipTeleport then
            doTeleportCycle()
        end
        if not God.Enabled then return end
        God.Active = true

        if not God.HeartbeatConnection then
            God.HeartbeatConnection = RunService.Heartbeat:Connect(function()
                if not God.Active then return end
                local root = getRoot()
                if root and God.SavedCFrame and root.Position.Y <= God.SavedCFrame.Position.Y - 50 then
                    root.CFrame = God.SavedCFrame
                    root.AssemblyLinearVelocity = Vector3.zero
                end
                setRepToGhost()
                RunService.RenderStepped:Wait()
                clearRep()
            end)
        end
    end)
end

function God.Disable()
    God.Enabled = false
    God.Active = false

    if God.HeartbeatConnection then
        God.HeartbeatConnection:Disconnect()
        God.HeartbeatConnection = nil
    end
    if God.LoopThread then
        task.cancel(God.LoopThread)
        God.LoopThread = nil
    end

    God.Teleporting = false
    clearRep()
    destroyGhost()

    local root = getRoot()
    if root and God.SavedCFrame and root.Position.Y <= God.SavedCFrame.Position.Y - 50 then
        root.CFrame = God.SavedCFrame
        root.AssemblyLinearVelocity = Vector3.zero
    end
    destroyPlatform()

    local char = getChar()
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                workspace.CurrentCamera.CameraSubject = hum
            end)
        end
    end

    if getgenv().delvape then
        pcall(getgenv().delvape, "godmode")
        pcall(getgenv().delvape, "godmodegui")
    end
end

function God.Toggle()
    if God.Enabled then
        God.Disable()
    else
        God.Enable(false)
    end
end

