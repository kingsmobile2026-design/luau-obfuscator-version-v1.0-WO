-- //======= 유틸: 플레이어 찾기 =======//
local function findPlayer(query)
    if type(query) ~= "string" then return nil end
    query = query:gsub("^%s+", ""):gsub("%s+$", "")
    if #query < 2 then return nil end

    local qLower = query:lower()
    local partial = nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local name = plr.Name:lower()
        local display = (plr.DisplayName or ""):lower()

        if name == qLower or display == qLower then
            return plr
        end
        if name:find(qLower, 1, true) or display:find(qLower, 1, true) then
            if not partial then
                partial = plr
            end
        end
    end
    return partial
end

local function notify(title, text, duration)
    if typeof(getgenv().notify) == "function" then
        getgenv().notify(title, text, duration)
    else
        print("[" .. tostring(title) .. "] " .. tostring(text))
    end
end

-- //======= WHITELIST 모듈 (재접 시 초기화) =======//
local Whitelist = {
    List = {},          -- [UserId] = Player
    ShowList = false,   -- 목록 UI ON/OFF
}

function Whitelist.Add(playerOrName)
    local plr = typeof(playerOrName) == "Instance" and playerOrName:IsA("Player") and playerOrName
        or findPlayer(tostring(playerOrName))
    if not plr then
        notify("Whitelist", "플레이어를 찾을 수 없습니다 (2글자+)", 2)
        return false
    end
    if plr == LocalPlayer then
        notify("Whitelist", "자기 자신은 등록할 수 없습니다", 2)
        return false
    end
    if Whitelist.List[plr.UserId] then
        notify("Whitelist", plr.Name .. " 님은 이미 등록되어 있습니다", 2)
        return false
    end
    Whitelist.List[plr.UserId] = plr
    notify("Whitelist", plr.Name .. " (" .. (plr.DisplayName or "") .. ") 화이트리스트 등록", 2)
    return true
end

function Whitelist.Remove(playerOrName)
    local plr = typeof(playerOrName) == "Instance" and playerOrName:IsA("Player") and playerOrName
        or findPlayer(tostring(playerOrName))
    if not plr then return false end
    if Whitelist.List[plr.UserId] then
        Whitelist.List[plr.UserId] = nil
        notify("Whitelist", plr.Name .. " 화이트리스트 해제", 2)
        return true
    end
    return false
end

function Whitelist.IsWhitelisted(player)
    if not player then return false end
    return Whitelist.List[player.UserId] ~= nil
end

function Whitelist.GetNames()
    local names = {}
    for _, plr in pairs(Whitelist.List) do
        if plr and plr.Parent == Players then
            table.insert(names, plr.DisplayName .. " (@" .. plr.Name .. ")")
        end
    end
    table.sort(names)
    return names
end

function Whitelist.Clear()
    Whitelist.List = {}
    notify("Whitelist", "화이트리스트 초기화됨", 2)
end

