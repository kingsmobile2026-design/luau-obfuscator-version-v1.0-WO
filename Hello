-- //======= 유틸: 플레이어 찾기 (닉 / 표시닉 부분매칭, 2글자+) =======//
local function findPlayer(query)
    if type(query) ~= "string" then return nil end
    query = query:gsub("^%s+", ""):gsub("%s+$", "")
    if #query < 2 then return nil end

    local qLower = query:lower()
    local exact, partial = nil, nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local name = plr.Name:lower()
        local display = (plr.DisplayName or ""):lower()

        if name == qLower or display == qLower then
            return plr
        end
        if name:find(qLower, 1, true) or display:find(qLower, 1, true) then
            if not partial then
                partial = plr
            end
        end
    end
    return exact or partial
end

-- //======= ATTACH 모듈 =======//
local Attach = {
    Enabled = false,
    Target = nil,
    TargetHRP = nil,
    LocalHRP = nil,
    Connection = nil,
    CharConn = nil,
}

local function setupLocalChar(char)
    if not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart", 8)
    if hrp then
        Attach.LocalHRP = hrp
        pcall(setPhysicsRep, hrp, nil)
    end
end

if LocalPlayer.Character then
    task.spawn(setupLocalChar, LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(setupLocalChar)

RunService.Heartbeat:Connect(function()
    if not Attach.Enabled then return end
    if not Attach.TargetHRP or not Attach.TargetHRP.Parent then return end
    if not Attach.LocalHRP or not Attach.LocalHRP.Parent then return end

    pcall(function()
        setPhysicsRep(Attach.LocalHRP, Attach.TargetHRP)
        Attach.LocalHRP.CFrame = Attach.TargetHRP.CFrame * (getgenv().AttachOffset or Config.AttachOffset)
    end)
end)

function Attach.Start(player)
    if not player or not player:IsA("Player") then return false end

    Attach.Stop()
    Attach.Target = player
    Attach.Enabled = true

    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        Attach.TargetHRP = player.Character.HumanoidRootPart
    end

    Attach.CharConn = player.CharacterAdded:Connect(function(char)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if hrp then
            Attach.TargetHRP = hrp
        end
    end)

    if getgenv().addvape then
        pcall(getgenv().addvape, "attach")
    end
    return true
end

function Attach.Stop()
    Attach.Enabled = false
    Attach.Target = nil
    Attach.TargetHRP = nil

    if Attach.CharConn then
        Attach.CharConn:Disconnect()
        Attach.CharConn = nil
    end

    if Attach.LocalHRP then
        pcall(setPhysicsRep, Attach.LocalHRP, nil)
    end

    if getgenv().delvape then
        pcall(getgenv().delvape, "attach")
        pcall(getgenv().delvape, "at")
        pcall(getgenv().delvape, "looptp")
    end
end

function Attach.Toggle(player)
    if Attach.Enabled then
        Attach.Stop()
        return false
    else
        return Attach.Start(player)
    end
end

-- //======= INVIS 모듈 (순수 로직) =======//
local Invis = {
    Alive = true,
    Enabled = false,
    AnimationId = "rbxassetid://107114358965793",
    AnimationTime = 18,
    FadeTransparency = 0.5,
}

local invisConns = {}
local invisDescConns = {}
local transparencyCache = {}
local invisChar, invisHum, invisHRP
local invisAnim, invisTrack
local invisBusy = false

local function disconnectTable(t)
    for k, c in pairs(t) do
        pcall(function() c:Disconnect() end)
        t[k] = nil
    end
end

local function destroyInvisAnim()
    if invisTrack then
        pcall(function() invisTrack:Stop(0) end)
        pcall(function() invisTrack:Destroy() end)
        invisTrack = nil
    end
    if invisAnim then
        pcall(function() invisAnim:Destroy() end)
        invisAnim = nil
    end
end

local function loadInvisAnim(humanoid)
    if invisTrack and invisHum == humanoid then
        return invisTrack
    end
    destroyInvisAnim()
    local animator = humanoid:FindFirstChildWhichIsA("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    invisAnim = Instance.new("Animation")
    invisAnim.AnimationId = Invis.AnimationId
    local ok, track = pcall(animator.LoadAnimation, animator, invisAnim)
    if not ok or not track then
        destroyInvisAnim()
        return nil
    end
    track.Priority = Enum.AnimationPriority.Action4
    invisTrack = track
    return invisTrack
end

local function isHitbox(obj)
    return obj.Name:lower():find("hitbox", 1, true) ~= nil
end

local function getOrigTransparency(obj)
    if transparencyCache[obj] == nil then
        transparencyCache[obj] = obj.Transparency
    end
    return transparencyCache[obj]
end

local function applyFade(obj)
    if not invisHRP then return end
    if obj:IsA("BasePart") then
        if obj == invisHRP then return end
        local orig = getOrigTransparency(obj)
        if isHitbox(obj) or orig == 1 then
            obj.Transparency = 1
        else
            obj.Transparency = Invis.FadeTransparency
        end
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        local parent = obj.Parent
        if parent and isHitbox(parent) then return end
        if getOrigTransparency(obj) ~= 1 then
            obj.Transparency = Invis.FadeTransparency
        end
    end
end

local function applyFadeAll(char)
    for _, d in ipairs(char:GetDescendants()) do
        applyFade(d)
    end
end

local function refreshFade()
    for obj, orig in pairs(transparencyCache) do
        if not obj.Parent then
            transparencyCache[obj] = nil
        elseif obj:IsA("BasePart") then
            if obj ~= invisHRP then
                if isHitbox(obj) or orig == 1 then
                    obj.Transparency = 1
                else
                    obj.Transparency = Invis.FadeTransparency
                end
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            local parent = obj.Parent
            if (not parent or not isHitbox(parent)) and orig ~= 1 then
                obj.Transparency = Invis.FadeTransparency
            end
        end
    end
end

local function restoreTransparency()
    for obj, orig in pairs(transparencyCache) do
        if obj.Parent then
            pcall(function() obj.Transparency = orig end)
        end
        transparencyCache[obj] = nil
    end
end

local function stopInvisTrack()
    if invisTrack and invisTrack.IsPlaying then
        pcall(function() invisTrack:Stop(0) end)
    end
end

local function setupInvisChar(char)
    disconnectTable(invisDescConns)
    restoreTransparency()
    destroyInvisAnim()
    invisChar, invisHum, invisHRP = nil, nil, nil
    if not char then return end

    local hum = char:WaitForChild("Humanoid", 10)
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if not Invis.Alive or LocalPlayer.Character ~= char or not hum or not hrp then
        return
    end
    invisChar = char
    invisHum = hum
    invisHRP = hrp

    invisDescConns.descendantAdded = char.DescendantAdded:Connect(function(d)
        if Invis.Enabled then
            task.defer(applyFade, d)
        end
    end)

    if Invis.Enabled then
        applyFadeAll(char)
    end
end

local function invisHeartbeat()
    if not Invis.Alive or not Invis.Enabled or invisBusy then return end
    if not invisChar or not invisHum or not invisHRP then return end
    if invisHum.Health <= 0 or not invisHRP.Parent then return end

    invisBusy = true
    refreshFade()
    local track = loadInvisAnim(invisHum)

    pcall(function()
        if track then
            if not track.IsPlaying then
                track:Play(0)
            end
            track.TimePosition = Invis.AnimationTime
            track:AdjustSpeed(0)
            track:AdjustWeight(1, 0)
        end
        RunService.RenderStepped:Wait()
    end)

    stopInvisTrack()
    invisBusy = false
end

function Invis.SetEnabled(state)
    Invis.Enabled = state == true
    if Invis.Enabled then
        if invisChar then
            applyFadeAll(invisChar)
        end
    else
        stopInvisTrack()
        restoreTransparency()
    end
    return Invis.Enabled
end

function Invis.Toggle()
    return Invis.SetEnabled(not Invis.Enabled)
end

function Invis.Unload()
    if not Invis.Alive then return end
    Invis.Alive = false
    Invis.Enabled = false
    disconnectTable(invisDescConns)
    disconnectTable(invisConns)
    stopInvisTrack()
    restoreTransparency()
    destroyInvisAnim()
    if getgenv().TSBInvisibility == Invis then
        getgenv().TSBInvisibility = nil
    end
end

invisConns.heartbeat = RunService.Heartbeat:Connect(invisHeartbeat)
invisConns.characterAdded = LocalPlayer.CharacterAdded:Connect(function(c)
    task.spawn(setupInvisChar, c)
end)
