local function getAttachOffset()
    local x = Config.AttachX or 0
    local y = Config.AttachY or 0
    local z = Config.AttachZ or 6
    local pitch = math.rad(Config.AttachPitch or 0)
    local yaw = math.rad(Config.AttachYaw or 0)
    local roll = math.rad(Config.AttachRoll or 0)
    return CFrame.Angles(pitch, yaw, roll) * CFrame.new(x, y, z)
end

