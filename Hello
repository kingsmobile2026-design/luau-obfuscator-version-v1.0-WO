    return KillFarm.Enabled
end

-- //======= TPA (Attach All) 모듈 =======//
local TPA = {
    Running = false,
    Thread = nil,
    VoidConn = nil,
    Settings = {
        delay = 0.3,            -- 대상당 Attach 유지 시간
        maxTargets = 7,         -- 최대 대상 수 (화이트리스트 제외)
        excludeSelf = true,
        randomOrder = false,
        voidY = -100,
        voidDuration = 1.2,
    }
}

function TPA.Start()
    if TPA.Running then
        TPA.Stop()
        return false
    end

    -- KillFarm과 충돌 방지
    if KillFarm.Enabled then KillFarm.Stop() end

    TPA.Running = true
    getgenv().TpaRunning = true
    if getgenv().addvape then pcall(getgenv().addvape, "teleportallgui") end

    TPA.Thread = task.spawn(function()
        local returnCF = nil
        local myChar0 = LocalPlayer.Character
        local myHRP0 = myChar0 and myChar0:FindFirstChild("HumanoidRootPart")
        if myHRP0 then returnCF = myHRP0.CFrame end

        -- 화이트리스트/자신 제외, 중복 없이 후보 수집
        local list = {}
        local seen = {}
        local skipped = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if TPA.Settings.excludeSelf and plr == LocalPlayer then
                -- skip self
            elseif Whitelist.IsWhitelisted(plr) then
                skipped = skipped + 1
            elseif not seen[plr.UserId] then
                seen[plr.UserId] = true
                table.insert(list, plr)
            end
        end
        if skipped > 0 then
            notify("TPA", "화이트리스트 " .. skipped .. "명 스킵", 1.5)
        end

        if TPA.Settings.randomOrder then
            for i = #list, 2, -1 do
                local j = math.random(1, i)
                list[i], list[j] = list[j], list[i]
            end
        end

        -- 최대 7명 (서버 인원이 더 적으면 그만큼만)
        local maxN = TPA.Settings.maxTargets or 7
        if #list > maxN then
            local trimmed = {}
            for i = 1, maxN do
                trimmed[i] = list[i]
            end
            list = trimmed
        end

        if #list == 0 then
            notify("TPA", "대상이 없습니다", 2)
            TPA.Running = false
            getgenv().TpaRunning = false
            return
        end

        notify("TPA", #list .. "명 처리 (마지막은 TP, 최대 " .. maxN .. ")", 2)

        local delay = TPA.Settings.delay > 0 and TPA.Settings.delay or 0.3

        -- 마지막 제외 Attach, 마지막만 TP
        for i, plr in ipairs(list) do
            if not TPA.Running then break end
            if not (plr and plr.Parent == Players and plr.Character) then continue end
            local isLast = (i == #list)
            if isLast then
                Attach.Stop()
                local myChar = LocalPlayer.Character
                local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local theirHRP = plr.Character:FindFirstChild("HumanoidRootPart")
                if myHRP and theirHRP then
                    pcall(setPhysicsRep, myHRP, nil)
                    myHRP.CFrame = theirHRP.CFrame
                    myHRP.AssemblyLinearVelocity = Vector3.zero
                    myHRP.AssemblyAngularVelocity = Vector3.zero
                end
                task.wait(delay)
            else
                Attach.Start(plr)
                task.wait(delay)
            end
        end

        Attach.Stop()
        task.wait(0.1)

        if not TPA.Running then
            getgenv().TpaRunning = false
            if getgenv().delvape then pcall(getgenv().delvape, "teleportallgui") end
            return
        end

        -- 공허: Heartbeat마다 Y=-10000 CFrame 고정
        notify("TPA", #list .. "명 완료 → 공허 Heartbeat 고정", 1.5)

        getgenv().TPA_Voiding = true

        if not AntiVoid.Enabled then
            AntiVoid.Start()
            notify("TPA", "안티보이드 자동 ON", 1)
        end

        local voidY = TPA.Settings.voidY or -10000
        local voidDur = TPA.Settings.voidDuration or 1.2
        local voidCF = CFrame.new(0, voidY, 0)

        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    pcall(setPhysicsRep, p, nil)
                end
            end
        end

        if TPA.VoidConn then
            pcall(function() TPA.VoidConn:Disconnect() end)
            TPA.VoidConn = nil
        end

        TPA.VoidConn = RunService.Heartbeat:Connect(function()
            if not getgenv().TPA_Voiding then return end
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = voidCF
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                pcall(function()
                    hrp.Velocity = Vector3.zero
                    hrp.RotVelocity = Vector3.zero
                end)
            end
        end)

        task.wait(voidDur)

        if TPA.VoidConn then
            TPA.VoidConn:Disconnect()
            TPA.VoidConn = nil
        end

        -- 원래 위치로 복귀
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and returnCF then
            for _ = 1, 6 do
                if hrp and hrp.Parent then
                    hrp.CFrame = returnCF
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
                RunService.Heartbeat:Wait()
            end
        end

        getgenv().TPA_Voiding = false
        notify("TPA", "공허 완료 → 복귀", 2)

        TPA.Running = false
        getgenv().TpaRunning = false
        if getgenv().delvape then pcall(getgenv().delvape, "teleportallgui") end
        notify("TPA", "Attach All 완료 (" .. #list .. "명)", 2)
    end)

    return true
end

function TPA.Stop()
    TPA.Running = false
    getgenv().TpaRunning = false
    getgenv().TPA_Voiding = false
    if TPA.VoidConn then
        pcall(function() TPA.VoidConn:Disconnect() end)
        TPA.VoidConn = nil
    end
    Attach.Stop()
    pcall(function()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
    end)
    if getgenv().delvape then pcall(getgenv().delvape, "teleportallgui") end
    notify("TPA", "Attach All 중지", 2)
end


