-- //======= LOOPFLING 모듈 =======//
local LoopFling = {
    Enabled = false,
    Targets = {},
    Thread = nil,
}

local function isTooHigh(char)
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { char, LocalPlayer.Character }
    params.FilterType = Enum.RaycastFilterType.Blacklist
    local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -500, 0), params)
    if hit then
        return (hrp.Position - hit.Position).Magnitude > 30
    end
    return true
end

function LoopFling.Start(playerList)
    LoopFling.Stop()

    local targets = {}
    if typeof(playerList) == "table" then
        for _, p in ipairs(playerList) do
            local plr = typeof(p) == "Instance" and p:IsA("Player") and p or findPlayer(tostring(p))
            if plr and plr ~= LocalPlayer then
                table.insert(targets, plr)
            end
        end
    else
        local plr = typeof(playerList) == "Instance" and playerList:IsA("Player") and playerList or findPlayer(tostring(playerList))
        if plr then table.insert(targets, plr) end
    end

    if #targets == 0 then
        notify("LoopFling", "대상을 찾을 수 없습니다", 2)
        return false
    end

    LoopFling.Targets = targets
    LoopFling.Enabled = true
    getgenv().LoopFlingActive = true

    local names = {}
    for _, t in ipairs(targets) do
        table.insert(names, t.Name)
        if getgenv().addTargetCmd then
            pcall(getgenv().addTargetCmd, t, "loopfling")
        end
    end
    notify("LoopFling", table.concat(names, ", ") .. " LoopFling 시작!", 2)

    if getgenv().addvape then pcall(getgenv().addvape, "loopfling") end

    local idx = 1
    LoopFling.Thread = task.spawn(function()
        settings().Physics.AllowSleep = false
        pcall(function()
            if sethiddenproperty then
                sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
                sethiddenproperty(LocalPlayer, "MaxSimulationRadius", math.huge)
            end
        end)

        while LoopFling.Enabled and getgenv().LoopFlingActive do
            local target = LoopFling.Targets[idx]
            if target and target.Parent == Players and target.Character then
                local char = LocalPlayer.Character
                if char then
                    local myHRP = char:FindFirstChild("HumanoidRootPart")
                    local theirHRP = target.Character:FindFirstChild("HumanoidRootPart")
                    if myHRP and theirHRP and not isTooHigh(target.Character) then
                        local savedCF = myHRP.CFrame
                        local conn = nil
                        local stopFlag = false

                        conn = RunService.Heartbeat:Connect(function()
                            if not LoopFling.Enabled or not target or not target.Character or stopFlag then
                                if conn then conn:Disconnect() end
                                return
                            end
                            local c2 = LocalPlayer.Character
                            if not c2 then
                                if conn then conn:Disconnect() end
                                return
                            end
                            local hrp3 = c2:FindFirstChild("HumanoidRootPart")
                            local hrp4 = target.Character:FindFirstChild("HumanoidRootPart")
                            local hum = c2:FindFirstChildOfClass("Humanoid")
                            if not hrp3 or not hrp4 then
                                if conn then conn:Disconnect() end
                                return
                            end
                            if isTooHigh(target.Character) then
                                stopFlag = true
                                if conn then conn:Disconnect() end
                                return
                            end
                            if hum then hum.PlatformStand = true end
                            for _, d in pairs(c2:GetDescendants()) do
                                if d:IsA("BasePart") then
                                    d.CanCollide = false
                                    d.CanTouch = false
                                    d.CanQuery = false
                                    d.Velocity = Vector3.new(math.huge, math.huge, math.huge)
                                    d.RotVelocity = Vector3.new(math.huge, math.huge, math.huge)
                                end
                            end
                            pcall(setPhysicsRep, hrp3, hrp4)
                            hrp3.Velocity = Vector3.new(math.huge, math.huge, math.huge)
                            hrp3.RotVelocity = Vector3.new(math.huge, math.huge, math.huge)
                            hrp3.CFrame = hrp4.CFrame
                                * CFrame.Angles(math.rad(math.random(0,360)), math.rad(math.random(0,360)), math.rad(math.random(0,360)))
                                * CFrame.new(0, 0, 0.05)
                        end)

                        local start = tick()
                        while not stopFlag and tick() - start <= 3 and LoopFling.Enabled do
                            task.wait()
                        end
                        if conn then conn:Disconnect() end

                        if LocalPlayer.Character then
                            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                            if hum then hum.PlatformStand = false end
                            if hrp then
                                hrp.CFrame = savedCF
                                hrp.Velocity = Vector3.zero
                                hrp.RotVelocity = Vector3.zero
                            end
                        end
                        task.wait(0.2)
                    end
                end
            end

            idx = idx + 1
            if idx > #LoopFling.Targets then idx = 1 end
            task.wait(0.1)
        end
    end)

    return true
end

function LoopFling.Stop()
    LoopFling.Enabled = false
    getgenv().LoopFlingActive = false
    LoopFling.Targets = {}
    if LoopFling.Thread then
        -- thread will exit on next loop check
        LoopFling.Thread = nil
    end
    if getgenv().removeTargetCmd then
        pcall(getgenv().removeTargetCmd, nil, "loopfling")
    end
    if getgenv().delvape then pcall(getgenv().delvape, "loopfling") end
    notify("LoopFling", "LoopFling 중지됨", 2)
end

function LoopFling.Toggle(playerOrList)
    if LoopFling.Enabled then
        LoopFling.Stop()
        return false
    else
        return LoopFling.Start(playerOrList)
    end
end

-- //======= STAND 모듈 (간소화) =======//
local Stand = {
    Enabled = false,
    Target = nil,
    Follow = true,
    Conn = nil,
    Offset = CFrame.new(-2, 2, 5),
}

function Stand.Start(player, followMode)
    Stand.Stop()
    local plr = typeof(player) == "Instance" and player:IsA("Player") and player or findPlayer(tostring(player))
    if not plr then
        notify("Stand", "대상을 찾을 수 없습니다", 2)
        return false
    end

    Stand.Target = plr
    Stand.Enabled = true
    Stand.Follow = followMode ~= false

    if getgenv().addvape then pcall(getgenv().addvape, "standgui") end
    notify("Stand", plr.Name .. " 스탠드 " .. (Stand.Follow and "Follow" or "Don't Follow") .. " 시작", 2)

    Stand.Conn = RunService.Heartbeat:Connect(function()
        if not Stand.Enabled or not Stand.Target then return end
        local myChar = LocalPlayer.Character
        local theirChar = Stand.Target.Character
        if not myChar or not theirChar then return end
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        local theirHRP = theirChar:FindFirstChild("HumanoidRootPart")
        if not myHRP or not theirHRP then return end

        if Stand.Follow then
            local hum = myChar:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function() hum.AutoRotate = false end)
                hum.PlatformStand = true
            end
            for _, d in pairs(myChar:GetDescendants()) do
                if d:IsA("BasePart") then
                    d.CanCollide = false
                end
            end
            setPhysicsRep(myHRP, theirHRP)
            myHRP.CFrame = theirHRP.CFrame * Stand.Offset
            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero
        end
    end)

    return true
end

function Stand.Stop()
    Stand.Enabled = false
    Stand.Target = nil
    if Stand.Conn then
        Stand.Conn:Disconnect()
        Stand.Conn = nil
    end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum then
            hum.PlatformStand = false
            pcall(function() hum.AutoRotate = true end)
        end
        if hrp then
            setPhysicsRep(hrp, nil)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end
    if getgenv().delvape then pcall(getgenv().delvape, "standgui") end
    notify("Stand", "스탠드 OFF", 1.5)
end

function Stand.Toggle(player, followMode)
    if Stand.Enabled then
        Stand.Stop()
        return false
    else
        return Stand.Start(player, followMode)
    end
end

-- //======= TPA (Teleport All) 모듈 =======//
local TPA = {
    Running = false,
    Thread = nil,
    Settings = {
        delay = 0.05,           -- 더 빠르게 (기존 0.3 → 0.05)
        excludeSelf = true,
        randomOrder = false,
        tpDir = "behind",       -- behind / front / side
        ox = 0, oy = 0, oz = 0,
        voidY = -499,           -- 공허 높이
        voidDuration = 1,       -- 공허에 머무는 시간 (초)
    }
}

local function getTPOffset()
    local ox, oy, oz = TPA.Settings.ox, TPA.Settings.oy, TPA.Settings.oz
    if TPA.Settings.tpDir == "behind" then oz = oz + 2
    elseif TPA.Settings.tpDir == "front" then oz = oz - 2
    elseif TPA.Settings.tpDir == "side" then ox = ox + 2
    end
    return CFrame.new(ox, oy, oz)
end

function TPA.Start()
    if TPA.Running then
        TPA.Stop()
        return false
    end

    TPA.Running = true
    getgenv().TpaRunning = true
    if getgenv().addvape then pcall(getgenv().addvape, "teleportallgui") end
    notify("TPA", "Teleport All 시작 (고속)", 2)

    TPA.Thread = task.spawn(function()
        -- 시작 위치 저장 (나중에 공허 후 복귀용)
        local returnCF = nil
        local myChar0 = LocalPlayer.Character
        local myHRP0 = myChar0 and myChar0:FindFirstChild("HumanoidRootPart")
        if myHRP0 then
            returnCF = myHRP0.CFrame
        end

        local list = {}
        local skipped = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if TPA.Settings.excludeSelf and plr == LocalPlayer then
                -- skip self
            elseif Whitelist.IsWhitelisted(plr) then
                skipped = skipped + 1
            else
                table.insert(list, plr)
            end
        end
        if skipped > 0 then
            notify("TPA", "화이트리스트 " .. skipped .. "명 스킵", 1.5)
        end

        if TPA.Settings.randomOrder then
            for i = #list, 2, -1 do
                local j = math.random(1, i)
                list[i], list[j] = list[j], list[i]
            end
        end

        local offset = getTPOffset()
        local delay = TPA.Settings.delay > 0 and TPA.Settings.delay or 0.05

        -- 순차 텔레포트 (고속)
        for i, plr in ipairs(list) do
            if not TPA.Running then break end
            local myChar = LocalPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local theirChar = plr.Character
            local theirHRP = theirChar and theirChar:FindFirstChild("HumanoidRootPart")

            if myHRP and theirHRP then
                setPhysicsRep(myHRP, theirHRP)
                myHRP.CFrame = theirHRP.CFrame * offset
                myHRP.AssemblyLinearVelocity = Vector3.zero
                task.wait(delay)
                setPhysicsRep(myHRP, nil)
            end
        end

        if not TPA.Running then
            getgenv().TpaRunning = false
            if getgenv().delvape then pcall(getgenv().delvape, "teleportallgui") end
            return
        end

        -- ===== 전부 완료 후: 공허 1초 → 안티보이드 자동 ON → 복귀 =====
        notify("TPA", "전원 이동 완료 → 공허 진입", 1.5)

        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myHRP then
            -- 복귀 위치 갱신 (마지막 위치)
            if not returnCF then
                returnCF = myHRP.CFrame
            end

            -- 안티보이드 자동 켜기
            local antiVoidWasOff = not AntiVoid.Enabled
            if antiVoidWasOff then
                AntiVoid.Start()
                notify("TPA", "안티보이드 자동 ON", 1)
            end

            -- 공허로 이동
            local voidY = TPA.Settings.voidY or -499
            myHRP.CFrame = CFrame.new(myHRP.Position.X, voidY, myHRP.Position.Z)
            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero

            -- 공허에서 대기
            local voidDur = TPA.Settings.voidDuration or 1
            task.wait(voidDur)

            -- 원래 위치로 복귀
            if TPA.Running and LocalPlayer.Character then
                local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp and returnCF then
                    hrp.CFrame = returnCF
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end

            notify("TPA", "공허 완료 → 복귀", 2)
        end

        TPA.Running = false
        getgenv().TpaRunning = false
        if getgenv().delvape then pcall(getgenv().delvape, "teleportallgui") end
        notify("TPA", "Teleport All 완료", 2)
    end)

    return true
end

function TPA.Stop()
    TPA.Running = false
    getgenv().TpaRunning = false
    if getgenv().delvape then pcall(getgenv().delvape, "teleportallgui") end
    notify("TPA", "Teleport All 중지", 2)
end

