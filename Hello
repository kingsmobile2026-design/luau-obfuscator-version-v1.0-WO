-- //======= ATTACH 모듈 =======//
local Attach = {
    Enabled = false,
    Target = nil,
    TargetHRP = nil,
    LocalHRP = nil,
    Humanoid = nil,
    CharConn = nil,
    VoidHeight = -50,
    SafePosition = Vector3.new(0, 50, 0)
}

local function setupLocalChar(char)
    if not char then return end
    Attach.LocalHRP = char:WaitForChild("HumanoidRootPart", 5)
    Attach.Humanoid = char:WaitForChild("Humanoid", 5)
    if Attach.LocalHRP then
        setPhysicsRep(Attach.LocalHRP, nil)
    end
    if Attach.Enabled and Attach.Target then
        Attach.Start(Attach.Target)
    end
end

if LocalPlayer.Character then
    task.spawn(setupLocalChar, LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(setupLocalChar)

local function executeAttachLoop()
    if not Attach.LocalHRP or not Attach.LocalHRP.Parent then return end

    if not Attach.TargetHRP or not Attach.TargetHRP.Parent then
        if Attach.Target and Attach.Target.Character then
            Attach.TargetHRP = Attach.Target.Character:FindFirstChild("HumanoidRootPart")
        end
    end

    if Attach.TargetHRP and Attach.TargetHRP.Parent then
        local tPos = Attach.TargetHRP.Position
        if math.isfinite(tPos.X) and math.isfinite(tPos.Y) and math.isfinite(tPos.Z) then
            if tPos.Y > Attach.VoidHeight then
                Attach.SafePosition = tPos + Vector3.new(0, 10, 0)
            end
        end
    end

    if Attach.LocalHRP.Position.Y < Attach.VoidHeight then
        Attach.LocalHRP.CFrame = CFrame.new(Attach.SafePosition)
        Attach.LocalHRP.AssemblyLinearVelocity = Vector3.zero
        return
    end

    if not Attach.Enabled or not Attach.Target or not Attach.TargetHRP or not Attach.TargetHRP.Parent then
        return
    end

    Attach.LocalHRP.CanCollide = true
    Attach.TargetHRP.CanCollide = true

    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(LocalPlayer, "MaximumSimulationRadius", 100000)
            sethiddenproperty(LocalPlayer, "SimulationRadius", 100000)
            sethiddenproperty(Attach.LocalHRP, "NetworkIsSleeping", false)
        end
    end)

    setPhysicsRep(Attach.LocalHRP, Attach.TargetHRP)

    local targetCF = Attach.TargetHRP.CFrame
    local vel = Attach.TargetHRP.AssemblyLinearVelocity
    if not (math.isfinite(vel.X) and math.isfinite(vel.Y) and math.isfinite(vel.Z)) then
        vel = Vector3.zero
    end

    local predictedCF = targetCF
    Attach.LocalHRP.CFrame = predictedCF * (getgenv().AttachOffset or Config.AttachOffset)
    Attach.LocalHRP.AssemblyLinearVelocity = vel
end

RunService.Stepped:Connect(executeAttachLoop)
RunService.RenderStepped:Connect(executeAttachLoop)
RunService.Heartbeat:Connect(executeAttachLoop)

function Attach.Start(player)
    local plr = typeof(player) == "Instance" and player:IsA("Player") and player or findPlayer(tostring(player))
    if not plr then return false end

    Attach.Stop()
    Attach.Target = plr
    Attach.Enabled = true

    if plr.Character then
        Attach.TargetHRP = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:WaitForChild("HumanoidRootPart", 2)
        if Attach.LocalHRP and Attach.TargetHRP then
            setPhysicsRep(Attach.LocalHRP, Attach.TargetHRP)
        end
    end

    Attach.CharConn = plr.CharacterAdded:Connect(function(char)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if hrp then
            Attach.TargetHRP = hrp
            if Attach.LocalHRP then
                setPhysicsRep(Attach.LocalHRP, Attach.TargetHRP)
            end
        end
    end)

    if getgenv().addvape then pcall(getgenv().addvape, "attach") end
    return true
end

function Attach.Stop()
    Attach.Enabled = false
    Attach.Target = nil
    Attach.TargetHRP = nil

    if Attach.CharConn then
        Attach.CharConn:Disconnect()
        Attach.CharConn = nil
    end

    if Attach.LocalHRP then
        setPhysicsRep(Attach.LocalHRP, nil)
        if Attach.Humanoid then
            Attach.Humanoid.PlatformStand = false
            pcall(function() Attach.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        pcall(function()
            Attach.LocalHRP.AssemblyLinearVelocity = Vector3.zero
            Attach.LocalHRP.Velocity = Vector3.zero
        end)
    end

    if getgenv().delvape then
        pcall(getgenv().delvape, "attach")
        pcall(getgenv().delvape, "at")
        pcall(getgenv().delvape, "looptp")
    end
end

-- //======= INVIS 모듈 =======//
local Invis = {
    Alive = true,
    Enabled = false,
    AnimationId = "rbxassetid://107114358965793",
    AnimationTime = 18,
    FadeTransparency = 0.5,
}

local invisConns = {}
local invisDescConns = {}
local transparencyCache = {}
local invisChar, invisHum, invisHRP
local invisAnim, invisTrack
local invisBusy = false

local function disconnectTable(t)
    for k, c in pairs(t) do
        pcall(function() c:Disconnect() end)
        t[k] = nil
    end
end

local function destroyInvisAnim()
    if invisTrack then
        pcall(function() invisTrack:Stop(0) end)
        pcall(function() invisTrack:Destroy() end)
        invisTrack = nil
    end
    if invisAnim then
        pcall(function() invisAnim:Destroy() end)
        invisAnim = nil
    end
end

local function loadInvisAnim(humanoid)
    if invisTrack and invisHum == humanoid then return invisTrack end
    destroyInvisAnim()
    local animator = humanoid:FindFirstChildWhichIsA("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    invisAnim = Instance.new("Animation")
    invisAnim.AnimationId = Invis.AnimationId
    local ok, track = pcall(animator.LoadAnimation, animator, invisAnim)
    if not ok or not track then
        destroyInvisAnim()
        return nil
    end
    track.Priority = Enum.AnimationPriority.Action4
    invisTrack = track
    return invisTrack
end

local function isHitbox(obj)
    return obj.Name:lower():find("hitbox", 1, true) ~= nil
end

local function getOrigTransparency(obj)
    if transparencyCache[obj] == nil then
        transparencyCache[obj] = obj.Transparency
    end
    return transparencyCache[obj]
end

local function applyFade(obj)
    if not invisHRP then return end
    if obj:IsA("BasePart") then
        if obj == invisHRP then return end
        local orig = getOrigTransparency(obj)
        if isHitbox(obj) or orig == 1 then
            obj.Transparency = 1
        else
            obj.Transparency = Invis.FadeTransparency
        end
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        local parent = obj.Parent
        if parent and isHitbox(parent) then return end
        if getOrigTransparency(obj) ~= 1 then
            obj.Transparency = Invis.FadeTransparency
        end
    end
end

local function applyFadeAll(char)
    for _, d in ipairs(char:GetDescendants()) do
        applyFade(d)
    end
end

local function refreshFade()
    for obj, orig in pairs(transparencyCache) do
        if not obj.Parent then
            transparencyCache[obj] = nil
        elseif obj:IsA("BasePart") then
            if obj ~= invisHRP then
                if isHitbox(obj) or orig == 1 then
                    obj.Transparency = 1
                else
                    obj.Transparency = Invis.FadeTransparency
                end
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            local parent = obj.Parent
            if (not parent or not isHitbox(parent)) and orig ~= 1 then
                obj.Transparency = Invis.FadeTransparency
            end
        end
    end
end

local function restoreTransparency()
    for obj, orig in pairs(transparencyCache) do
        if obj.Parent then
            pcall(function() obj.Transparency = orig end)
        end
        transparencyCache[obj] = nil
    end
end

local function stopInvisTrack()
    if invisTrack and invisTrack.IsPlaying then
        pcall(function() invisTrack:Stop(0) end)
    end
end

local function setupInvisChar(char)
    disconnectTable(invisDescConns)
    restoreTransparency()
    destroyInvisAnim()
    invisChar, invisHum, invisHRP = nil, nil, nil
    if not char then return end

    local hum = char:WaitForChild("Humanoid", 10)
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if not Invis.Alive or LocalPlayer.Character ~= char or not hum or not hrp then return end
    invisChar = char
    invisHum = hum
    invisHRP = hrp

    invisDescConns.descendantAdded = char.DescendantAdded:Connect(function(d)
        if Invis.Enabled then task.defer(applyFade, d) end
    end)

    if Invis.Enabled then applyFadeAll(char) end
end

local function invisHeartbeat()
    if not Invis.Alive or not Invis.Enabled or invisBusy then return end
    if not invisChar or not invisHum or not invisHRP then return end
    if invisHum.Health <= 0 or not invisHRP.Parent then return end

    invisBusy = true
    refreshFade()
    local track = loadInvisAnim(invisHum)

    pcall(function()
        if track then
            if not track.IsPlaying then track:Play(0) end
            track.TimePosition = Invis.AnimationTime
            track:AdjustSpeed(0)
            track:AdjustWeight(1, 0)
        end
        RunService.RenderStepped:Wait()
    end)

    stopInvisTrack()
    invisBusy = false
end

function Invis.SetEnabled(state)
    Invis.Enabled = state == true
    if Invis.Enabled then
        if invisChar then applyFadeAll(invisChar) end
    else
        stopInvisTrack()
        restoreTransparency()
    end
    return Invis.Enabled
end

function Invis.Toggle()
    return Invis.SetEnabled(not Invis.Enabled)
end

invisConns.heartbeat = RunService.Heartbeat:Connect(invisHeartbeat)
invisConns.characterAdded = LocalPlayer.CharacterAdded:Connect(function(c)
    task.spawn(setupInvisChar, c)
end)
task.spawn(setupInvisChar, LocalPlayer.Character)
getgenv().TSBInvisibility = Invis

-- //======= GODMODE 모듈 =======//
local God = {
    Enabled = false,
    Active = false,
    LoopThread = nil,
    HeartbeatConnection = nil,
    GhostPart = nil,
    UndergroundPlatform = nil,
    SavedCFrame = nil,
    Teleporting = false,
}

local function getChar()
    return LocalPlayer.Character
end

local function getRoot()
    local c = getChar()
    if not c then return nil end
    return c:FindFirstChild("PhysicsRootPart") or c:FindFirstChild("HumanoidRootPart")
end

local function createGhost()
    if God.GhostPart then
        pcall(function() God.GhostPart:Destroy() end)
        God.GhostPart = nil
    end
    local p = Instance.new("Part")
    p.Name = "GhostPart"
    p.Anchored = false
    p.CanCollide = false
    p.Transparency = 1
    p.Size = Vector3.new(0.1, 0.1, 0.1)
    God.GhostPart = p
    return p
end

local function destroyGhost()
    if God.GhostPart then
        pcall(function() God.GhostPart:Destroy() end)
        God.GhostPart = nil
    end
end

local function setRepToGhost()
    local c = getChar()
    if not c or not God.GhostPart then return end
    pcall(function()
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") then
                pcall(sethiddenproperty or set_hidden_property or function() end, d, "NetworkIsSleeping", false)
                setPhysicsRep(d, God.GhostPart)
            end
        end
    end)
end

local function clearRep()
    local c = getChar()
    if not c then return end
    pcall(function()
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") then
                setPhysicsRep(d, nil)
            end
        end
    end)
end

local function createPlatform(cf)
    if God.UndergroundPlatform and God.UndergroundPlatform.Parent then
        God.UndergroundPlatform.CFrame = cf * CFrame.new(0, -5, 0)
        return God.UndergroundPlatform
    end
    if God.UndergroundPlatform then
        pcall(function() God.UndergroundPlatform:Destroy() end)
        God.UndergroundPlatform = nil
    end
    local p = Instance.new("Part")
    p.Name = "GodmodeSafetyPlatform"
    p.Size = Vector3.new(100, 4, 100)
    p.CFrame = cf * CFrame.new(0, -5, 0)
    p.Anchored = true
    p.CanCollide = true
    p.Transparency = 1
    p.Parent = workspace
    God.UndergroundPlatform = p
    return p
end

local function destroyPlatform()
    if God.UndergroundPlatform then
        pcall(function() God.UndergroundPlatform:Destroy() end)
        God.UndergroundPlatform = nil
    end
end

local function doTeleportCycle()
    local char = getChar()
    local root = getRoot()
    if not root or not char then return end

    if God.Teleporting then
        if God.SavedCFrame and root.Position.Y <= God.SavedCFrame.Position.Y - 50 then
            root.CFrame = God.SavedCFrame
            root.AssemblyLinearVelocity = Vector3.zero
        end
        return
    end

    if not God.SavedCFrame or root.Position.Y > God.SavedCFrame.Position.Y - 50 then
        God.SavedCFrame = root.CFrame
    end

    local under = God.SavedCFrame * CFrame.new(0, Config.TeleportDepth, 0)
    createPlatform(under)
    God.Teleporting = true

    local fakePaused = getgenv().fakepos_enabled == true
    if fakePaused then
        getgenv().fakepos_pause = true
        task.wait(0.12)
    end

    for _ = 1, 6 do
        RunService.Stepped:Wait()
        if God.Enabled then
            root.CFrame = under
            root.AssemblyLinearVelocity = Vector3.zero
        else
            break
        end
    end

    task.wait(0.225)

    if root and God.SavedCFrame then
        for _ = 1, 6 do
            RunService.Stepped:Wait()
            root.CFrame = God.SavedCFrame
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end

    God.Teleporting = false
    if fakePaused then
        getgenv().fakepos_pause = false
    end
end

function God.Enable(skipTeleport)
    if God.Enabled then return end
    God.Enabled = true
    if getgenv().addvape then pcall(getgenv().addvape, "godmode") end

    createGhost()
    if God.LoopThread then
        task.cancel(God.LoopThread)
        God.LoopThread = nil
    end

    God.LoopThread = task.spawn(function()
        if not skipTeleport then doTeleportCycle() end
        if not God.Enabled then return end
        God.Active = true

        if not God.HeartbeatConnection then
            God.HeartbeatConnection = RunService.Heartbeat:Connect(function()
                if not God.Active then return end
                local root = getRoot()
                if root and God.SavedCFrame and root.Position.Y <= God.SavedCFrame.Position.Y - 50 then
                    root.CFrame = God.SavedCFrame
                    root.AssemblyLinearVelocity = Vector3.zero
                end
                setRepToGhost()
                RunService.RenderStepped:Wait()
                clearRep()
            end)
        end
    end)
end

function God.Disable()
    God.Enabled = false
    God.Active = false

    if God.HeartbeatConnection then
        God.HeartbeatConnection:Disconnect()
        God.HeartbeatConnection = nil
    end
    if God.LoopThread then
        task.cancel(God.LoopThread)
        God.LoopThread = nil
    end

    God.Teleporting = false
    clearRep()
    destroyGhost()

    local root = getRoot()
    if root and God.SavedCFrame and root.Position.Y <= God.SavedCFrame.Position.Y - 50 then
        root.CFrame = God.SavedCFrame
        root.AssemblyLinearVelocity = Vector3.zero
    end
    destroyPlatform()

    local char = getChar()
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() workspace.CurrentCamera.CameraSubject = hum end)
        end
    end

    if getgenv().delvape then
        pcall(getgenv().delvape, "godmode")
        pcall(getgenv().delvape, "godmodegui")
    end
end

function God.Toggle()
    if God.Enabled then God.Disable() else God.Enable(false) end
end

-- //======= ANTI-VOID 모듈 =======//
local AntiVoid = {
    Enabled = false,
    Part = nil,
    ConnFPDH = nil,
    ConnRender = nil,
    ConnHealth = nil,
    ConnChar = nil,
    LastHealth = 100,
}

local function setupAntiVoidChar(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 3)
    local hrp = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 3)
    if not humanoid or not hrp then return end

    AntiVoid.LastHealth = humanoid.Health
    if AntiVoid.ConnHealth then AntiVoid.ConnHealth:Disconnect() AntiVoid.ConnHealth = nil end
    if AntiVoid.ConnRender then AntiVoid.ConnRender:Disconnect() AntiVoid.ConnRender = nil end

    AntiVoid.ConnRender = RunService.RenderStepped:Connect(function()
        if not AntiVoid.Enabled then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        local hum = character:FindFirstChildOfClass("Humanoid")
        if root and hum then
            AntiVoid.LastHealth = hum.Health
            if AntiVoid.Part then
                AntiVoid.Part.CFrame = CFrame.new(root.Position.X, -10008, root.Position.Z)
            end
        end
    end)

    AntiVoid.ConnHealth = humanoid.HealthChanged:Connect(function(newHealth)
        if not AntiVoid.Enabled then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        if newHealth <= 0 and root and root.CFrame.Y <= 0 then
            humanoid.Health = AntiVoid.LastHealth
        end
    end)
end

function AntiVoid.Stop()
    AntiVoid.Enabled = false
    if AntiVoid.ConnFPDH then AntiVoid.ConnFPDH:Disconnect() AntiVoid.ConnFPDH = nil end
    if AntiVoid.ConnRender then AntiVoid.ConnRender:Disconnect() AntiVoid.ConnRender = nil end
