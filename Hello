-- //======= setPhysicsRep / sethiddenproperty 호환 =======//
local _sethiddenproperty2
if _sethiddenproperty then
    _sethiddenproperty2 = _sethiddenproperty
else
    _sethiddenproperty2 = sethiddenproperty or set_hidden_property or set_hidden_prop
end

local function setPhysicsRep(part, root)
    if not part then return end
    local fn = _sethiddenproperty2 or sethiddenproperty or set_hidden_property or set_hidden_prop
    if not fn then return end

    local ref = root
    if root ~= nil and type(InstanceHandle) == "table" and type(InstanceHandle.new) == "function" then
        local ok, handle = pcall(InstanceHandle.new, root)
        if ok and handle then ref = handle end
    end

    pcall(fn, part, "NetworkOwner", LocalPlayer)
    pcall(fn, part, "NetworkOwnershipRule", Enum.NetworkOwnership.Manual)
    pcall(fn, part, "PhysicsRepRootRef", ref)
end

