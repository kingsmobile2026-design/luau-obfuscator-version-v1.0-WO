        GodBtn.BackgroundColor3 = Theme.On
    else
        GodBtn.Text = "○ Godmode OFF"
        GodBtn.BackgroundColor3 = Theme.Off
    end
end

-- //======= 버튼 이벤트 =======//
AttachBtn.MouseButton1Click:Connect(function()
    if Attach.Enabled then
        Attach.Stop()
        refreshUI()
        return
    end

    local query = NameBox.Text
    local target = findPlayer(query)
    if not target then
        StatusLabel.Text = "플레이어를 찾을 수 없음 (2글자 이상)"
        StatusLabel.TextColor3 = Theme.Off
        return
    end

    local ok = Attach.Start(target)
    if ok then
        refreshUI()
    else
        StatusLabel.Text = "Attach 실패"
        StatusLabel.TextColor3 = Theme.Off
    end
end)

InvisBtn.MouseButton1Click:Connect(function()
    Invis.Toggle()
    refreshUI()
end)

GodBtn.MouseButton1Click:Connect(function()
    God.Toggle()
    refreshUI()
end)

-- 대상이 나갔을 때 정리
Players.PlayerRemoving:Connect(function(plr)
    if Attach.Target == plr then
        Attach.Stop()
        refreshUI()
    end
end)

-- 초기 UI
refreshUI()

-- 외부에서 제어할 수 있도록 노출
getgenv().TSB_Combined = {
    Attach = Attach,
    Invis = Invis,
    God = God,
    RefreshUI = refreshUI,
    FindPlayer = findPlayer,
    Gui = ScreenGui,
}

print("[TSB Combined] Godmode + Invis + Attach UI loaded")
