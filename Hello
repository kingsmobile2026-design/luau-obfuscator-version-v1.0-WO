Players.PlayerRemoving:Connect(function(plr)
    if Attach.Target == plr then Attach.Stop() end
    if Stand.Target == plr then Stand.Stop() end
    if LoopFling.Enabled then
        for i, t in ipairs(LoopFling.Targets) do
            if t == plr then
                table.remove(LoopFling.Targets, i)
                break
            end
        end
        if #LoopFling.Targets == 0 then LoopFling.Stop() end
    end
    refreshUI()
end)

