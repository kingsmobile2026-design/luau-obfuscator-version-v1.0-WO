-- //======= 숫자 파서 (NaN, inf, 1e-100 등) =======//
local function parseNumber(str, default)
    if str == nil then return default end
    if type(str) == "number" then return str end
    str = tostring(str):gsub("^%s+", ""):gsub("%s+$", "")
    local lower = str:lower()
    if str == "" then return default end
    if lower == "nan" or lower == "(nan)" then return (0/0) end
    if lower == "inf" or lower == "+inf" or lower == "infinity" or lower == "+infinity" then return math.huge end
    if lower == "-inf" or lower == "-infinity" then return -math.huge end
    if lower == "huge" or lower == "math.huge" then return math.huge end
    -- 과학적 표기 / 일반 숫자 (1e100, 1e-999, -3.5e20 등)
    local n = tonumber(str)
    if n ~= nil then return n end
    n = tonumber(lower)
    if n ~= nil then return n end
    return default
end


